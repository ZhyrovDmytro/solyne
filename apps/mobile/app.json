{
  "expo": {
    "name": "Solyne",
    "slug": "solyne",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "solyne",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Solyne to use the photo you choose for your tan preview.",
          "cameraPermission": "Allow Solyne to take a photo for your tan preview.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Solyne to access photos you choose.",
          "savePhotosPermission": "Allow Solyne to save your generated tan to Photos.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F1EB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
