# API
PORT=3000
NODE_ENV=development
MAX_UPLOAD_MB=15
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_TIMEOUT_MS=180000
KLING_MODEL=kling-image-v3_0_omni
KLING_TIMEOUT_MS=210000
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-kontext-pro
REPLICATE_TIMEOUT_MS=120000

# Mobile (127.0.0.1 works in the iOS simulator; use the Mac LAN IP on a device.)
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# Public website origin after publication, e.g. https://your-owned-domain.com
# Serve /privacy, /terms and /support with the matching docs/legal content.
EXPO_PUBLIC_WEBSITE_URL=
